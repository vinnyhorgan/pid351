# pid351 kernel configuration fragment
#
# Merged over arm64 defconfig. This is not yet the lean kernel - it is the
# kernel that boots our hardware and nothing else's. Stripping it further is
# worth doing once there is a real workload to measure the result against;
# doing it now would mean tuning for a program that does not exist.
#
# Every driver turned on below appeared in the binding census taken from the
# running device (docs/hardware.md), not from a defconfig or a wiki.

# ---- no modules. one kernel, one file, no loader, nothing to go missing ----
# CONFIG_MODULES is not set

# ---- one SoC ----
CONFIG_ARCH_ROCKCHIP=y
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# ---- no network. there is no network in the design ----
# CONFIG_NET is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set

# ---- no GPU, no video codec. both power domains are off at runtime ----
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set

# ---- display: exactly the chain that bound on the device ----
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_PANEL_ELIDA_KD35T133=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y

# fbcon is our substitute for the serial console we do not have. It costs a
# little memory and it is the only way a failed boot can tell us anything.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ---- PMIC and everything hanging off it ----
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_RK808=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RTC_DRV_RK808=y
CONFIG_COMMON_CLK_RK808=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_CHARGER_RK817=y
CONFIG_POWER_SUPPLY=y

# ---- audio ----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_SND_SIMPLE_CARD=y

# ---- storage ----
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- input: the pad is USB HID behind an internal hub ----
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_INPUT_EVDEV=y

# ---- power management. the whole point of the project ----
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_CPU_IDLE=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_ROCKCHIP_OTP=y
CONFIG_NVMEM=y

# ---- misc devices the census showed bound ----
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_PWM=y
CONFIG_INPUT_PWM_VIBRA=y
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_MTD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y

# The ring buffer is our only log. Our own stdout is redirected into it, so
# it has to hold a full kernel boot plus a few hundred lines of ours.
CONFIG_LOG_BUF_SHIFT=19

# ---- userspace is one static binary in an initramfs ----
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y

# The USB gadget tried to bind g_mass_storage at boot and failed with -22.
# Off for now - but worth remembering that a mass storage gadget is exactly
# the `ums` capability the stock U-Boot lacks, so pid351 could one day offer
# the SD card to the laptop over the same cable that charges it.
# CONFIG_USB_GADGET is not set

# Server-class noise inherited from arm64 defconfig.
# CONFIG_IPMI_HANDLER is not set

# ---- things we will never do ----
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_NFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
