+/* Let the charge pump come up before anything downstream of it is enabled.
+ * The pump is switched on by the widget below; this runs after that write. */
+static int rk817_hp_cp_event(struct snd_soc_dapm_widget *w,
+			     struct snd_kcontrol *kcontrol, int event)
+{
+	if (event == SND_SOC_DAPM_POST_PMU)
+		msleep(20);
+
+	return 0;
+}
