+	/* playback path headphones
+	 *
+	 * Sequenced, because these four are not interchangeable. Widgets of the
+	 * same type are ordered by subseq, then by register, then by shift - so
+	 * left at the default subseq of zero, AHP_CFG0 (0x3d) sorts ahead of
+	 * AHP_CP (0x3f) and the output stage is switched on before the charge
+	 * pump that is meant to be feeding it. An output stage opening onto an
+	 * unpowered pump is a click at the speaker, once per boot, on every
+	 * board that wires the speaker to the headphone pad.
+	 *
+	 * The pump also needs time. Twenty milliseconds is far more than it
+	 * should want and is spent once, inside stream startup, where nothing
+	 * is waiting on it.
+	 */
+	SND_SOC_DAPM_SUPPLY_S("Headphone CP Discharge LDO", 1, RK817_CODEC_AHP_CP, 3, 1, NULL, 0),
+	SND_SOC_DAPM_SUPPLY_S("Headphone Charge Pump", 2, RK817_CODEC_AHP_CP, 4, 0,
+		rk817_hp_cp_event, SND_SOC_DAPM_POST_PMU),
+	SND_SOC_DAPM_SUPPLY_S("Headphone Pre Amp", 3, RK817_CODEC_AHP_CFG0, 5, 1, NULL, 0),
+	SND_SOC_DAPM_SUPPLY_S("Headphone OStage", 4, RK817_CODEC_AHP_CFG0, 6, 1, NULL, 0),
